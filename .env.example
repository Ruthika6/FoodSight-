# Environment variables template
# Copy to .env if you need local overrides

# Application Environment (development, production, testing)
APP_ENV=development

# Open-Meteo Weather API Base URL (Open-Meteo is free and does not require an API key)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Optional custom port for Streamlit
STREAMLIT_SERVER_PORT=8501
